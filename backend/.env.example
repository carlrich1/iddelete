# Copy to .env (in privacy1/backend/) and fill in.

# ---- Required to make sessions secure in production ----
FLASK_SECRET_KEY=replace-with-32-random-bytes
EY_COOKIE_SECURE=1                # set to 1 when behind HTTPS

# ---- Database (defaults to backend/iddelete.sqlite3) ----
# EY_DB_PATH=/var/lib/ID Delete/erase.sqlite3

# ---- Real scanners ----
# Uncomment to load the production-pattern broker scanners in addition to
# the deterministic mocks.
# EY_REAL_SCANNERS=1
# Actually fire HTTP requests to broker opt-out endpoints. Leave OFF in
# development — the scanners run in dry-run mode by default.
# EY_LIVE_REQUESTS=1

# ---- Stripe ----
# Without these, billing endpoints return "billing_not_configured" and the
# rest of the product keeps working.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PERSONAL=price_xxx
# STRIPE_PRICE_FAMILY=price_xxx
# STRIPE_PRICE_PRO=price_xxx

# ---- Logging ----
# EY_LOG_LEVEL=DEBUG
