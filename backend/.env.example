# Copy to .env (in privacy1/backend/) and fill in.

# ---- Required to make sessions secure in production ----
FLASK_SECRET_KEY=replace-with-32-random-bytes
EY_COOKIE_SECURE=1                # set to 1 when behind HTTPS

# ---- Database (defaults to backend/iddelete.sqlite3) ----
# EY_DB_PATH=/var/lib/ID Delete/erase.sqlite3

# ---- Real scanners ----
# Uncomment to load the production-pattern broker scanners in addition to
# the deterministic mocks.
# EY_REAL_SCANNERS=1
# Actually fire HTTP requests to broker opt-out endpoints. Leave OFF in
# development — the scanners run in dry-run mode by default.
# EY_LIVE_REQUESTS=1

# ---- Stripe ----
# Without these, billing endpoints return "billing_not_configured" and the
# rest of the product keeps working.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PERSONAL=price_xxx
# STRIPE_PRICE_FAMILY=price_xxx
# STRIPE_PRICE_PRO=price_xxx

# ---- Email (pluggable provider) ----
# Pick one: console | resend | postmark | sendgrid | smtp
# Default is "console" which logs emails to stdout (great for dev).
# EY_EMAIL_PROVIDER=resend
# EY_EMAIL_FROM="ID Delete <hello@iddelete.com>"
# EY_EMAIL_REPLY_TO=help@iddelete.com
# Provider-specific (only set the one you're using):
# RESEND_API_KEY=re_xxxxxxxxxxxx
# POSTMARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Site URL (used to build links in outbound emails) ----
# Defaults to https://iddelete.com — override for staging.
# EY_SITE_URL=https://iddelete.com

# ---- CAPTCHA (signup) ----
# Free, privacy-friendly hCaptcha. Sign up at https://hcaptcha.com.
# Both keys must be set for CAPTCHA to be enforced; otherwise it's skipped.
# HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
# HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# ---- Rate limiting ----
# In-memory per-IP rate limit on auth endpoints. Disable for local testing.
# EY_RATE_LIMIT_DISABLED=1

# ---- Logging ----
# EY_LOG_LEVEL=DEBUG
